# ─── SERVIDOR ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=seu_jwt_secret_muito_longo_e_aleatorio_aqui
JWT_REFRESH_SECRET=seu_refresh_secret_diferente_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── SUPABASE ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# ─── OPENAI (chat GPT-4o / GPT-4o mini + Whisper para voz) ─────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── STRIPE ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=COLE_SUA_STRIPE_SECRET_KEY_AQUI
STRIPE_WEBHOOK_SECRET=COLE_SEU_WEBHOOK_SECRET_AQUI
STRIPE_PRICE_MENSAL=COLE_O_PRICE_ID_MENSAL_AQUI
STRIPE_PRICE_ANUAL=COLE_O_PRICE_ID_ANUAL_AQUI

# ─── RESEND (E-mail) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=may@seudominio.com.br
EMAIL_FROM_NAME=May — Sua Assistente de Vendas

# ─── DAILY.CO (Reuniões com IA — sala própria de videochamada) ─────────────────
# Conta grátis em https://dashboard.daily.co (Developers → API Keys)
DAILY_API_KEY=
# A chamada em si é grátis (10.000 min/mês). Gravação em nuvem é cobrada à parte
# (~R$0,07/min gravado) e exige cartão cadastrado no Daily — só ligue isto depois
# de cadastrar o cartão lá, senão a criação da sala passa a falhar.
DAILY_BILLING_ATIVO=false

# ─── APP ────────────────────────────────────────────────────────────────────────
APP_URL=https://seudominio.com.br
APP_NAME=May

# ─── LIMITES POR PLANO ──────────────────────────────────────────────────────────
# Mensagens de chat por mês
LIMITE_FREE=20
LIMITE_MENSAL=500
LIMITE_ANUAL=999999

# ─── Cielo (checkout do plano — é o gateway que o botão "Assinar" usa) ────────
# Sem estas três variáveis, toda tentativa de pagamento falha.
# Pegue em: painel da Cielo → e-Commerce → Chaves de integração (ambiente de produção).
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
# false = cobra de verdade. Qualquer outro valor (ou ausente) usa o sandbox,
# onde cartão real é sempre recusado.
CIELO_SANDBOX=false
